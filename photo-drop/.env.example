# Copy nothing by hand: the server creates .env with a random token the first time it runs.
# These are the settings you may add to .env yourself.

# PHOTO_DROP_TOKEN=   (made for you; delete the line and restart to get a new link)
# PHOTO_DROP_PORT=28765
# PHOTO_DROP_INBOX=/full/path/to/a/folder   (default: the inbox folder beside server.py)
# PHOTO_DROP_TAILNET=1   (also accept phones on your Tailscale network, for use away from home)
